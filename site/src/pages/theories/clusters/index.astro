---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PillarTabs from '../../../components/PillarTabs.astro';
import ClusterLists from '../../../components/ClusterLists.astro';
import { theoryTabs } from '../../../data/tabs';
---
<BaseLayout title="Theories by cluster" pillar="theories" crumbs={[{ label: 'Theories', href: '/theories/' }, { label: 'By cluster' }]}>
  <h1>Theories by cluster</h1>
  <PillarTabs tabs={theoryTabs} />
  <ClusterLists />
  <p class="banner" style="margin-top:28px">Some topics are drafts due to limited class sources.</p>
</BaseLayout>
