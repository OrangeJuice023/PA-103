---
import { WORLD } from '../data/world';
// Decorative hubs (lon, lat) that pulse on the map. They are not data.
const hubs = [
  [4.35, 50.85], [6.14, 46.2], [31.2, 30.0], [38.7, 9.0], [36.7, -3.4], [106.8, -6.2],
  [46.7, 24.7], [85.3, 27.7], [-56.2, -34.9], [-58.2, 6.8], [178.4, -18.1], [121.0, 14.6], [116.4, 39.9],
];
---
<div class="worldmap">
  <canvas id="world" role="img" aria-label="Pixel-art world map with pulsing points across regions"></canvas>
</div>
<style>
  .worldmap { margin: 28px auto 8px; max-width: 920px; }
  canvas { display: block; width: 100%; aspect-ratio: 144 / 57; image-rendering: pixelated; }
</style>
<script is:inline define:vars={{ WORLD, hubs }}>
  (function () {
    var cv = document.getElementById('world'), ctx = cv.getContext('2d');
    var cols = WORLD[0].length, rows = WORLD.length;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cell = 4, c1 = '#009edb', c2 = '#1b3f6b', cm = '#5a6b7b', frame = 0, visible = true;

    function colors() {
      var s = getComputedStyle(document.documentElement);
      c1 = s.getPropertyValue('--un-blue').trim() || c1;
      c2 = s.getPropertyValue('--org').trim() || c2;
      cm = s.getPropertyValue('--muted').trim() || cm;
    }
    function size() {
      var dpr = window.devicePixelRatio || 1, w = cv.clientWidth;
      cell = Math.max(2, Math.floor((w * dpr) / cols));
      cv.width = cell * cols; cv.height = cell * rows;
    }
    function hash(x, y) { var h = (x * 374761393 + y * 668265263) | 0; h = (h ^ (h >> 13)) * 1274126177; return ((h ^ (h >> 16)) >>> 0) / 4294967295; }

    var pts = hubs.map(function (h, i) {
      return { c: Math.floor((h[0] + 180) / 2.5), r: Math.floor((85 - h[1]) / 2.5), phase: i * 0.7 };
    });

    function draw(t) {
      ctx.clearRect(0, 0, cv.width, cv.height);
      var g = Math.max(1, Math.round(cell * 0.14)); // gap between pixels
      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var land = WORLD[r][c] === '#', a;
          if (land) {
            var wave = 0.5 + 0.5 * Math.sin((c + r * 0.6) * 0.16 - t * 1.4);
            var tw = hash(c, r + Math.floor(t * 1.5)) > 0.97 ? 0.35 : 0;
            a = 0.42 + 0.4 * wave + tw; ctx.fillStyle = c1;
          } else { a = 0.07; ctx.fillStyle = cm; }
          ctx.globalAlpha = Math.min(a, 1);
          ctx.fillRect(c * cell, r * cell, cell - g, cell - g);
        }
      }
      // pulses: pixel rings that grow, then fade
      ctx.fillStyle = c2;
      pts.forEach(function (p) {
        var k = ((t * 0.45 + p.phase) % 3) / 3; // 0..1
        var rad = Math.floor(k * 7), fade = 1 - k;
        ctx.globalAlpha = 1; ctx.fillRect(p.c * cell, p.r * cell, cell - g, cell - g);
        if (rad < 1) return;
        ctx.globalAlpha = fade * 0.9;
        for (var dy = -rad; dy <= rad; dy++) for (var dx = -rad; dx <= rad; dx++) {
          if (Math.max(Math.abs(dx), Math.abs(dy)) !== rad || (dx + dy) % 2) continue;
          var x = p.c + dx, y = p.r + dy;
          if (x < 0 || y < 0 || x >= cols || y >= rows) continue;
          ctx.fillRect(x * cell, y * cell, cell - g, cell - g);
        }
      });
      ctx.globalAlpha = 1;
    }
    function loop(ms) {
      if (visible) { if (frame++ % 60 === 0) colors(); draw(ms / 1000); }
      requestAnimationFrame(loop);
    }
    function start() {
      colors(); size(); draw(2);
      if (!reduce) requestAnimationFrame(loop);
    }
    new ResizeObserver(function () { size(); draw(2); }).observe(cv);
    if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }).observe(cv);
    start();
  })();
</script>
